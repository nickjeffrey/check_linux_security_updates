         fi
      fi
   fi
}


function centos() {
   #
   # Unlike RHEL, CentOS Stream is a rolling-release distro, not errata-driven, 
   # so this strategy really is not applicable for CentOS, you should just update regularly.
   # Note that we do not have a $regex_inclusions varible in this section
   # The closest approximation on CentOS to show pending updates would be: 
   # dnf repoquery --changelogs --upgrades     # <--- too verbose, includes brief description of each change
   # dnf check-update                          # <--- more appropriate for what we want here, just a list of available package updates
   # dnf list updates                          # <--- best option, similar to above but a bit less verbose
   #
   echo "$verbose" | grep -q yes && echo Running function centos
   #
   if [ -f "/etc/centos-release" ]; then
      #
      # initialize variables
      #
      regex_exclusions="^Name|^Updating and loading repositories|^Repositories loaded|^Last metadata expiration check|^Not root, Subscription Management repositories not updated|^Available Upgrades|^CentOS Stream|^Extra Packages"
      #
      # save pending updates to a temporary file for referencing by other scripts, refresh hourly
      #
      if [ ! -f "$output_file" ] ; then
         echo "$verbose" | grep -q yes && echo Creating new output file $output_file
         dnf list updates 2>&1 | grep -E -v "$regex_exclusions" > $output_file
      fi
   fi
}


function unknown_linux_version() {
   #
   # we only get this far if the Linux distro could not be detected
   #
   echo "$verbose" | grep -q yes && echo Running function unknown_linux_version
   #
   if [ ! -f "$output_file" ] ; then
      echo "UNKNOWN unrecognized Linux version, could not determine if any security updates are pending."
      exit $UNKNOWN
   fi
}


function create_html_file() {
   #
   echo "$verbose" | grep -q yes && echo Running function create_html_file
   #
   # break out of function early for unsupported Linux distros 
   if [ $(grep -c -E "PRETTY_NAME=\"Raspbian" "/etc/os-release") -gt 0 ]; then
      echo "$verbose" | grep -q yes && echo Detected Raspbian, exiting this function
      return
   fi
   if [ $(grep -c -E "PRETTY_NAME=\"Debian" "/etc/os-release") -gt 0 ]; then
      echo "$verbose" | grep -q yes && echo Detected Debian, exiting this function
      return
   fi
   if [ $(grep -c -E "PRETTY_NAME=\"Ubuntu" "/etc/os-release") -gt 0 ]; then
      echo "$verbose" | grep -q yes && echo Detected Ubuntu, exiting this function
      return
   fi
   #
   # We only get this far if we have a supported Linux distro
   #
   if [ -f "$html_file" ] ; then
      echo "$verbose" | grep -q yes && echo HTML report file $html_file already exists, no need to recreate at this time
      find "$html_file" -type f -mmin +1440 -delete	
   fi
   if [ ! -f "$html_file" ] ; then
      echo "$verbose" | grep -q yes && echo HTML report file $html_file does not exist, creating now.
      #
      # define variables
      #
      count=$(wc -l $output_file | awk '{print $1}')
      #
      # Figure out the base URL for assorted Linux flavours
      # 
      BASE_URL=" "
      grep -q -E "PRETTY_NAME=\"CentOS Stream"            /etc/os-release && BASE_URL="CentOS does not publish errata details"
      grep -q -E "PRETTY_NAME=\"Fedora Linux"             /etc/os-release && BASE_URL="https://bodhi.fedoraproject.org/updates"   
      grep -q -E "PRETTY_NAME=\"Rocky Linux"              /etc/os-release && BASE_URL="https://errata.rockylinux.org"   
      grep -q -E "PRETTY_NAME=\"Red Hat Enterprise Linux" /etc/os-release && BASE_URL="https://access.redhat.com/errata"
      grep -q -E "PRETTY_NAME=\"Oracle Linux"             /etc/os-release && BASE_URL="https://linux.oracle.com/errata"
      grep -q -E "PRETTY_NAME=\"AlmaLinux 8"              /etc/os-release && BASE_URL="https://errata.almalinux.org/8"
      grep -q -E "PRETTY_NAME=\"AlmaLinux 9"              /etc/os-release && BASE_URL="https://errata.almalinux.org/9"
      grep -q -E "PRETTY_NAME=\"AlmaLinux 10"             /etc/os-release && BASE_URL="https://errata.almalinux.org/10"
      grep -q -E "PRETTY_NAME=\"AlmaLinux 11"             /etc/os-release && BASE_URL="https://errata.almalinux.org/11"
      grep -q -E "PRETTY_NAME=\"AlmaLinux 12"             /etc/os-release && BASE_URL="https://errata.almalinux.org/12"
      #
      # creating HTML header
      #
      echo '<html><body>'                                                                           > $html_file
      echo "<br>This report was generated by the $host_name:$0 script at $yyyymmddhhmm"            >> $html_file
      echo "<br>Hostname: $host_name"                                                              >> $html_file
      echo "<br>Operating system: $linux_distro"                                                   >> $html_file
      echo "<br>Last checked: $yyyymmddhhmm"                                                       >> $html_file
      echo "<br>Number of outstanding security updates: $count"                                    >> $html_file
      echo "<br><hr><br>"                                                                          >> $html_file
      echo '<table border=1>'                                                                      >> $html_file
      #
      # Run this section for CentOS Stream
      # CentOS does not publish security errata, so this table layout is different
      # Instead, we get output similar to:
      # $dnf list updates
      # Last metadata expiration check: 0:09:58 ago on Sun 20 Sep 2026 10:48:58 PM MDT.
      # Available Upgrades
      # NetworkManager.x86_64                  1:1.58.0-1.el10                 baseos
      # NetworkManager-libnm.x86_64            1:1.58.0-1.el10                 baseos
      # NetworkManager-tui.x86_64              1:1.58.0-1.el10                 baseos
      # amd-gpu-firmware.noarch                20260812-26.el10                appstream
      # attr.x86_64                            2.6.0-2.el10                    baseos
      # audit.x86_64                           4.2.1-3.el10                    baseos
      #
      if [ $(grep -c "CentOS Stream" "/etc/os-release") -gt 0 ]; then
         echo '<tr bgcolor=gray><td>Package </td><td> Version </td><td> Repository </td><td> Hostname </td><td> Linux Version </td><td> Last Checked </td></tr>' >> $html_file
         cat $output_file | while read -r package version repo; do
            [ -z "$package" ] && continue           #skip empty lines
            echo "<tr><td> $package </td><td> $version </td><td> $repository </td><td> $host_name </td><td> $linux_distro </td><td> $yyyymmddhhmm </td></tr>" >> $html_file
         done
      fi
      #
      # Run this section for Fedora
      #
      if [ $(grep -c -E "PRETTY_NAME=\"Fedora Linux" "/etc/os-release") -gt 0 ]; then
         echo '<tr bgcolor=gray><td>Vendor URL </td><td> Advisory </td><td> Severity </td><td> Package </td><td> hostname </td><td> Linux Version </td><td> Last Checked </td></tr>' >> $html_file
         cat $output_file | while read -r advisory type severity package datestamp timestamp; do
            [ -z "$advisory" ] && continue                        #skip empty lines
            advisory_url="${BASE_URL}/${advisory}"                #generate the full URL for the advisory
            echo "<tr><td> <a href=$advisory_url>$advisory_url</a> </td><td> $advisory </td><td> $severity </td><td> $package </td> <td> $host_name </td><td> $linux_distro </td><td> $yyyymmddhhmm </td></tr>" >> $html_file
         done
      fi
      #
      # Run this section for AlmaLinux
      # AlmaLinux is difficult, they change the default URL syntax used by other RHEL derivatives
      #
      if [ $(grep -c -E "PRETTY_NAME=\"AlmaLinux" "/etc/os-release") -gt 0 ]; then
         echo '<tr bgcolor=gray><td>Vendor URL </td><td> Advisory </td><td> Severity </td><td> Package </td><td> hostname </td><td> Linux Version </td><td> Last Checked </td></tr>' >> $html_file
         cat $output_file | while read -r advisory severity package; do
            [ -z "$advisory" ] && continue                        #skip empty lines
            advisory_url="${BASE_URL}/${advisory}"                #generate the full URL for the advisory
            advisory_alma=`echo $advisory | sed -e 's/:/\-/g'`    #change the : to - in the advisory name
            advisory_url_alma="${BASE_URL}/${advisory_alma}.html" #append .html to URL
            advisory_url=$advisory_url_alma                       #save back to original variable name
            advisory=$advisory_alma                               #save back to original variable name
            echo "<tr><td> <a href=$advisory_url>$advisory_url</a> </td><td> $advisory </td><td> $severity </td><td> $package </td> <td> $host_name </td><td> $linux_distro </td><td> $yyyymmddhhmm </td></tr>" >> $html_file
         done
      fi
      #
      # Run this section for RHEL, Rocky Linux, Oracle Linux
      # These distros all use the same formatting for their advisories
      #
      if [ $(grep -c -E "PRETTY_NAME=\"Rocky Linux|PRETTY_NAME=\"Oracle Linux|PRETTY_NAME=\"Red Hat Enterprise Linux" "/etc/os-release") -gt 0 ] ; then
         echo '<tr bgcolor=gray><td>Vendor URL </td><td> Advisory </td><td> Severity </td><td> Package </td><td> hostname </td><td> Linux Version </td><td> Last Checked </td></tr>' >> $html_file
         cat $output_file | while read -r advisory severity package; do
            [ -z "$advisory" ] && continue                        #skip empty lines
            advisory_url="${BASE_URL}/${advisory}"                #generate the full URL for the advisory
            echo "<tr><td> <a href=$advisory_url>$advisory_url</a> </td><td> $advisory </td><td> $severity </td><td> $package </td> <td> $host_name </td><td> $linux_distro </td><td> $yyyymmddhhmm </td></tr>" >> $html_file
         done
      fi
      #
      # creating HTML footer
      #
      echo '</table></body></html>'     >> $html_file
   fi
}


function print_output_file() {
   #
   echo "$verbose" | grep -q yes && echo Running function print_output_file
   #
   # if we get this far, the output file can be used
   #
   if [ -f "$output_file" ] ; then
      echo "$verbose" | grep -q yes && ( test -f $output_file && echo Using   existing output file $output_file )
      #
      # initialize variables
      count=0
      #
      # count the number of pending updates
      #
      count=$(wc -l $output_file | awk '{print $1}')
      #
      # save nagios performance data to a variable
      #
      perf_data="updates=$count"
      #
      # save all the update names as a single string
      #
      pending_updates=$(cat $output_file | awk '{print $2}' | tr '\n' ' ')
      #
      if [ "$count" -gt 0 ]; then
         output_common="WARN $count security updates pending, get details with"
         output_distro=unknown
         grep -q -E "debian|ubuntu|raspbian"                                 /etc/os-release && output_distro='apt-get --simulate upgrade | grep -i ^Inst | grep "-security"'
         grep -q -E "rhel|fedora|centos|Oracle Linux|Rocky Linux|Alma Linux" /etc/os-release && output_distro='dnf updateinfo list --security'
         grep -q -E "CentOS Stream"                                          /etc/os-release && output_distro='dnf list updates'
         #
         # custom message for Linux distros that do not track security updates
         grep -q -E "CentOS Stream" /etc/os-release && output_common="WARN $count updates pending, but since CentOS   does not classify updates as security or bugfix or enhancement, this represents all available updates. Get details with "
         grep -q -E "Raspbian"      /etc/os-release && output_common="WARN $count updates pending, but since Raspbian does not classify updates as security or bugfix or enhancement, this represents all available updates. Get details with "
         #
         echo "$output_common $output_distro | $perf_data"
         exit $WARN
      else
         echo "OK $count security updates pending | $perf_data"
         exit $OK
      fi
   fi
}



