# NOTES
# -----
# Nagios check to return the number of available security updates
# Tested on Debian, Ubuntu, RHEL, Rocky, Alma, Oracle Linux, CentOS, Fedora.  Should be easy to add other distros.
#
# This script can take more than 60 seconds to run, so to avoid nagios check timeouts, execute this script hourly from the nagios crontab.  
# For example:
# $ crontab -l
# 1 * * * * /usr/local/nagios/libexec/check_linux_security_updates >/dev/null 2>&1 #nagios helper script

# USAGE
# -----
# It is assumed this script is located in /usr/local/nagios/libexec/ or equivalent for your environment
#
# Add a section similar to the following to services.cfg
#
#
#define service{
#        use                             generic-service
#        hostgroup_name                  all_linux
#        service_description             security updates
#        check_command                   check_linux_security_updates
#        }
#
# Add a section similar to the following to commands.cfg
## 'check_nagios_notficiations' command definition 
#define command{
#        command_name    check_linux_security_updates
#        command_line    $USER1$/check_linux_security_updates
#        }
#
#  This script is executed remotely on a monitored system by the NRPE or check_by_ssh
#  methods available in nagios.
#
#  If you are using the check_by_ssh method, you will need a section in the services.cfg
#  file on the nagios server that looks similar to the following.
#  This assumes that you already have ssh key pairs configured.
#   # Define service for checking linux security patches
#   define service{
#           use                             generic-24x7-service
#           hostgroup_name                  all_linux
#           service_description             security updates
#           check_command                   check_by_ssh!"/usr/local/nagios/libexec/check_linux_security_updates"
#           }
#
#  If you are using the check_nrpe method, you will need a section in the services.cfg
#  file on the nagios server that looks similar to the following.
#  This assumes that you already have ssh key pairs configured.
#   # Define service for checking time synchronization
#   define service{
#           use                             generic-24x7-service
#           hostgroup_name                  all_linux 
#           service_description             security updates
#           check_command                   check_nrpe!check_linux_security_updates -t 30
#           }
#
#  If using NRPE, you will also need a section defining the NRPE command in the /usr/local/nagios/nrpe.cfg file that looks like this:
#   command[check_linux_security_updates]=/usr/local/nagios/libexec/check_linux_security_updates




# declare variables
OK=0
WARN=1
CRITICAL=2
UNKNOWN=3
CHECK_NAME="security updates"
output_file=/tmp/check_linux_security_updates.tmp
html_file=/tmp/check_linux_security_updates.html
yyyymmddhhmm=`date '+%Y-%m-%d %H:%M'`
host_name=`hostname -f`
linux_distro=`grep PRETTY_NAME /etc/os-release | sed -e 's/"//g' | sed -e 's/^PRETTY_NAME=//g' | sed -e 's/(.*)//g'`
verbose=no



function check_output_file_age() {
   #
   echo "$verbose" | grep -q yes && echo Running function check_output_file_age
   #
   # delete the output file if it is too old
   #
   if [ ! -f "$output_file" ] ; then
      echo "$verbose" | grep -q yes && echo Did not find an existing output file $output_file
   fi
   if [ -f "$output_file" ] ; then
      # delete existing output file if it is too old
      find $output_file -type f -mmin +720 -delete	
      echo "$verbose" | grep -q yes && ( test -f $output_file || echo Deleted existing output file $output_file )
      echo "$verbose" | grep -q yes && ( test -f $output_file && echo Using   existing output file $output_file )
   fi
   #
   # delete the HTML report file if it is more than 24 hours old
   #
   if [ -f "$html_file" ] ; then
      find $html_file -type f -mmin +1440 -delete	
   fi
}



function debian_variants() {
   #
   # For apt based systems like Debian, Ubuntu
   # Note that apt does not have a stable CLI interface, use apt-get for scripts to avoid this warning:
   # WARNING: apt does not have a stable CLI interface. Use with caution in scripts.
   #
   # APT-based systems like Debian or Ubuntu do not publish RHSA/RHBA advisory metadata, so we need to use a different method.  
   # On Debian-based systems, security updates will come from the *-security repository, 
   # so the way to find only security fixes is to filter the available updates to only look for the updates 
   # from the *-security repository.
   #
   # Sample output:
   # $ apt-get --simulate upgrade | awk 'BEGIN{IGNORECASE=1} /^Inst/ && /security/' 
   # Inst libstdc++6 [14-20240412-0ubuntu1] (14.2.0-4ubuntu2~24.04 Ubuntu:24.04/noble-updates, Ubuntu:24.04/noble-security [amd64]) []
   # Inst libc6 [2.39-0ubuntu8] (2.39-0ubuntu8.6 Ubuntu:24.04/noble-updates, Ubuntu:24.04/noble-security [amd64])
   # Inst dpkg [1.22.6ubuntu6] (1.22.6ubuntu6.5 Ubuntu:24.04/noble-updates, Ubuntu:24.04/noble-security [amd64])
   # Inst perl-base [5.38.2-3.2build2] (5.38.2-3.2ubuntu0.2 Ubuntu:24.04/noble-updates, Ubuntu:24.04/noble-security [amd64]) []
   # Inst gpg [2.4.4-2ubuntu17] (2.4.4-2ubuntu17.4 Ubuntu:24.04/noble-updates, Ubuntu:24.04/noble-security [amd64]) [gnupg:amd64 ]
   # Inst sudo [1.9.15p5-3ubuntu5] (1.9.15p5-3ubuntu5.24.04.1 Ubuntu:24.04/noble-updates, Ubuntu:24.04/noble-security [amd64]) []
   # 
   echo "$verbose" | grep -q yes && echo Running function debian_variants
   #
   if [ -f "/bin/apt" ] && [ -f "/etc/os-release" ]; then
      # 
      # skip this section for Raspbian, we have a unique section just for Raspbian
      #
      if [ $(grep -c "Raspbian" "/etc/os-release") -gt 0 ]; then
         echo "$verbose" | grep -q yes && echo Detected Raspbian, exiting this function
         return
      fi
      #
      # save pending updates to a temporary file for referencing by other scripts
      #
      if [ ! -f "$output_file" ] ; then
         echo "$verbose" | grep -q yes && echo Creating new output file $output_file
         apt-get --simulate upgrade | awk 'BEGIN{IGNORECASE=1} /^Inst/ && /security/' > $output_file
      fi
   fi
}



function rhel_variants() {
   #
   # This section is for RHEL variants that publish security errata (RHEL, Fedora, Rocky, Alma, Oracle Linux)
   # 
   # dnf updateinfo list                <-- show all types of updates (including unspecified types)
   # dnf updateinfo list --security     <-- only show security updates
   # dnf updateinfo list --bugfix       <-- only show bugfix updates
   # dnf updateinfo list --enhancement  <-- only show bugfix updates
   #
   #
   # Sample output on RHEL (RHSA = Red Hat Security Advisory)
   # dnf updateinfo list --security     <-- only show security updates
   # Name            Severity       Package                                 
   # RHSA-2024:10281 Moderate/Sec.  kernel-4.18.0-553.30.1.el8_10.x86_64
   # RHSA-2024:10943 Moderate/Sec.  kernel-core-4.18.0-553.32.1.el8_10.x86_64
   #
   # Sample output on Alma Linux (ALSA = Alma Linux Security Advisory)
   # dnf updateinfo list --security     <-- only show security updates
   # Name            Severity       Package                                 
   # ALSA-2025:23279 Important/Sec. kernel-tools-libs-6.12.0-124.21.1.el10_1.x86_64
   # ALSA-2025:23484 Moderate/Sec.  libssh-0.11.1-5.el10_1.x86_64
   # ALSA-2025:23479 Moderate/Sec.  openssh-9.9p1-12.el10_1.alma.1.x86_64
   # ALSA-2025:23940 Moderate/Sec.  python3-3.12.12-1.el10_1.x86_64
   #
   # Sample output on Oracle Linux (ELSA = Enterprise Linux Security Advisory)
   # $ dnf updateinfo list --security 
   # ELSA-2026-18597   Low/Sec.       NetworkManager-1:1.54.3-2.0.1.el9.x86_64
   # ELSA-2026-19354   Important/Sec. PackageKit-1.2.6-2.0.1.el9_8.x86_64
   # ELSA-2026-60226-0 Moderate/Sec.  attr-2.6.0-1.el9_8.x86_64
   # ELSA-2026-39576   Important/Sec. cifs-utils-7.6-2.el9_8.x86_64
   #
   # Sample output on Rocky Linux (RLSA = Rocky Linux Security Advisory)
   # dnf updateinfo list --security     <-- only show security updates
   # RLSA-2025:21248 Moderate/Sec.  openssl-1:3.5.1-4.el10_1.x86_64
   # RLSA-2025:23295 Moderate/Sec.  podman-7:5.6.0-8.el10_1.x86_64
   # RLSA-2025:23940 Moderate/Sec.  python3-3.12.12-1.el10_1.x86_64
   # RLSA-2026:0002  Moderate/Sec.  tar-2:1.35-9.el10_1.x86_64
   #
   # Sample output on Fedora 40:
   # dnf updateinfo list
   # Updating and loading repositories:
   # Repositories loaded.
   # Name                   Type           Severity    Package                                     Issued
   # FEDORA-2025-b3e118a1c5 unspecified    None        plymouth-24.004.60-22.fc43.x86_64           2025-12-22 01:38:16
   # FEDORA-2026-758e825a45 enhancement    None        libsolv-0.7.35-3.fc43.x86_64                2026-01-07 01:08:44
   # FEDORA-2026-7b32524912 bugfix         Low         python3-boto3-1.42.23-1.fc43.noarch         2026-01-08 01:11:49
   # FEDORA-2026-1a2b3c4d   Important/Sec.             openssl security update
   #
   # Sample output on Fedora 44:
   # dnf updateinfo list --security
   # Repositories loaded.
   # Name                   Type     Severity                                          Package              Issued
   # FEDORA-2026-044e56d9ff security Moderate                         tar-2:1.35-9.fc44.x86_64 2026-09-09 04:47:08
   # FEDORA-2026-084c991d17 security Moderate                  libnghttp2-1.68.0-5.fc44.x86_64 2026-08-09 00:58:50
   # FEDORA-2026-0eb8e878b6 security Important                          jq-1.8.1-3.fc44.x86_64 2026-04-25 01:21:36
   # FEDORA-2026-110c1a7742 security Moderate                     p11-kit-0.26.5-1.fc44.x86_64 2026-08-08 01:36:59
   # FEDORA-2026-110c1a7742 security Moderate               p11-kit-trust-0.26.5-1.fc44.x86_64 2026-08-08 01:36:59
   # FEDORA-2026-2c124fcf93 security Important                    python3-3.14.7-1.fc44.x86_64 2026-08-19 01:01:07
   # FEDORA-2026-2c124fcf93 security Important               python3-libs-3.14.7-1.fc44.x86_64 2026-08-19 01:01:07
   #
   #
   #
   echo "$verbose" | grep -q yes && echo Running function rhel_variants
   #
   if [ -f "/etc/redhat-release" ] || [ -f "/etc/fedora-release" ] || [ -f "/etc/rocky-release" ] || [ -f "/etc/alma-release" ] || [ -f "/etc/oracle-release" ]; then
      #
      # initialize variables
      #
      regex_exclusions="^Name|^Updating and loading repositories|^Repositories loaded|^Last metadata expiration check|^Not root, Subscription Management repositories not updated|^Available Upgrades"
      regex_inclusions="^RHSA|^ALSA|^ELSA|^RLSA|^FEDORA"
      # 
      # skip this section for CentOS, greedy match for /etc/redhat-release, we have a unique section just for CentOS
      #
      if [ -f "/etc/centos-release" ]; then
         return
      fi
      #
      # If RHEL, confirm an active subscription, because RHEL needs a subscription for access to vendor repos
      #
      if [ -f "/etc/redhat-release" ] && grep -q "Red Hat Enterprise Linux" /etc/redhat-release; then
         : #bash built in no-op placeholder command to avoid errors due to nothing inside if block
         # trying to figure out how to determine subscription status without root privileges
         # this section is not complete, maybe a different check like check_rhel_subscription that runs as root?
      fi
      #
      # save pending updates to a temporary file for referencing by other scripts
      #
      if [ ! -f "$output_file" ] ; then
         echo "$verbose" | grep -q yes && echo Creating new output file $output_file
         dnf updateinfo list --security | grep -E -v "$regex_exclusions" | grep -E "$regex_inclusions" > $output_file
      fi
   fi
}



function raspbian() {
   # 
   # Raspbian does not publish security-only updates, so this will report on all available updates
   # Sample output below:
   # $ apt-get --simulate upgrade
   # NOTE: This is only a simulation!
   #    apt-get needs root privileges for real execution.
   #    Keep also in mind that locking is deactivated,
   #    so don't depend on the relevance to the real current situation!
   # Reading package lists... Done
   # Building dependency tree
   # Reading state information... Done
   # Calculating upgrade... Done
   # The following packages have been kept back:
   #   raspberrypi-sys-mods raspberrypi-ui-mods
   # 0 upgraded, 0 newly installed, 0 to remove and 2 not upgraded.
